// Repertoire Score — workflow.
//
// Consumes the selected clonotype dataset anchor and emits ONE composite score per
// clonotype. The score is a percentile-normalised linear combination of the per-clonotype
// signal columns discovered on the input:
//   1. discover candidate per-clonotype columns anchored on the clonotype-key axis;
//   2. classify each into a composite feature (mutations / pgen / convergence);
//   3. resolve the effective preset tier from the signals present that the family scores;
//   4. hand the feature columns + their coefficients to the pt recipe (compute-score.lib);
//   5. export the score PColumn with its spec + provenance trace.
//
// Output score PColumn:
//   name        : pl7.app/vdj/repertoireScore
//   axis        : input clonotypeKey (bulk) / scClonotypeKey (SC), unchanged
//   value range : [0, 1]
//   domain      : pl7.app/vdj/chain (bulk) | pl7.app/vdj/receptor (SC), mirroring input;
//                 pl7.app/vdj/repertoireScore/preset = "<family>-<variant>"
//   annotations : isScore, label, description, score/defaultCutoff; + injected trace.

wf := import("@platforma-sdk/workflow-tengo:workflow")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
ll := import("@platforma-sdk/workflow-tengo:ll")
json := import("json")
smart := import("@platforma-sdk/workflow-tengo:smart")
constants := import("@platforma-sdk/workflow-tengo:constants")
canonical := import("@platforma-sdk/workflow-tengo:canonical")
maps := import("@platforma-sdk/workflow-tengo:maps")

computeScore := import(":compute-score")

// --- Upstream column names / annotations we classify against. ---
// MUST stay in sync with the model's classifyColumn (model/src/index.ts), which recognizes
// the same columns for the reactive UI tier detection. No shared code across the TS/Tengo
// boundary, so any change here must be mirrored there (and vice-versa) — otherwise the UI
// advertises a signal this workflow can't feed, or the reverse.
SEQ_AA_CDR := "pl7.app/vdj/sequence/nAAMutationsCDR"
SEQ_NMUT := "pl7.app/vdj/sequence/nMutations"
SEQ_NMUT_COUNT := "pl7.app/vdj/sequence/nMutationsCount"
NEG_LOG_PGEN := "pl7.app/vdj/minlog10GenerationProbability"
CONV_NBFREQ := "pl7.app/vdj/convergence/nbFreq"
SC_CHAIN_DOMAIN := "pl7.app/vdj/scClonotypeChain"
SC_INDEX_DOMAIN := "pl7.app/vdj/scClonotypeChain/index"
CHAIN_DOMAIN := "pl7.app/vdj/chain"
GENE_DOMAIN := "pl7.app/vdj/gene"
RECEPTOR_DOMAIN := "pl7.app/vdj/receptor"
// Stamped by Generation Probability / Clonotype Convergence on columns computed on a subset of
// the dataset. Its value is the subset column's id, the same string as args.inputFilter.
SUBSET_DOMAIN := "pl7.app/inputSubset"
// The earlier name of SUBSET_DOMAIN, still carried by columns from runs made before the rename.
LEGACY_SUBSET_DOMAIN := "pl7.app/subset"

// The feature->signal map and the canonical feature order come from args
// (args.featureSignal / args.featureOrder) — single source of truth in the model's
// presets.ts, no Tengo copy to drift. The canonical order matters because Tengo map
// iteration is non-deterministic and this is a pure (reproducible) template.
SLOT_ORDER := ["A", "B", ""]

// Bulk single-chain axis chains that are LIGHT (secondary) — a bulk input on one of them is
// refused. Mirrors the light entries of slotOf's BULK_CHAIN_TO_SLOT.
LIGHT_BULK_CHAINS := { "IGLight": true, "IGKappa": true, "IGLambda": true }

// Tier -> preset-id variant tag.
TIER_VARIANT := { "1": "mutations", "2a": "convergence", "2b": "pgen" }

// Tier order; a family has a row (args.coefficients) for some of them. Mirrors the model's
// RUN_TIERS (presets.ts).
TIER_ORDER := ["1", "2a", "2b"]

// Block supplying each signal. Same names the UI's "run above" suggestion uses.
SIGNAL_SOURCE := { "pgen": "Generation Probability", "convergence": "Clonotype Convergence" }

// Features read from another feature's column through their own transform.
DERIVED := { ntMutationsDistance: { from: "ntMutations", transform: "distance" } }

// Classify one upstream column into { fk, transform, nullFill?, gene? } or undefined.
//   transform: "identity" — the raw value (DERIVED features and the J-gene sum set their own).
//   nullFill : "zero" fills a missing value with 0; otherwise the median.
//   gene     : "J" marks the J-gene count that is summed into the V-gene count of the same slot.
classify := func(col) {
	name := col.spec.name
	dom := is_undefined(col.spec.domain) ? {} : col.spec.domain
	if name == SEQ_AA_CDR {
		return { fk: "aaMutationsCDR", transform: "identity" }
	}
	if name == SEQ_NMUT {
		return { fk: "ntMutations", transform: "identity" }
	}
	if name == SEQ_NMUT_COUNT {
		// Single-cell: the primary chain of each slot only.
		if !is_undefined(dom[SC_INDEX_DOMAIN]) && dom[SC_INDEX_DOMAIN] != "primary" {
			return undefined
		}
		if dom[GENE_DOMAIN] == "V" {
			return { fk: "heavyNtMutationsVJ", transform: "identity" }
		}
		if dom[GENE_DOMAIN] == "J" {
			return { fk: "heavyNtMutationsVJ", transform: "identity", gene: "J" }
		}
		return undefined
	}
	if name == NEG_LOG_PGEN {
		// Already -log10(Pgen): larger = rarer. Used as-is.
		return { fk: "negLogPgen", transform: "identity" }
	}
	if name == CONV_NBFREQ {
		// A clonotype the convergence analysis left out gets no convergence credit.
		return { fk: "nbFreq", transform: "identity", nullFill: "zero" }
	}
	return undefined
}

// Chain slot for a column: bulk -> "" (single chain); SC -> scClonotypeChain domain
// ("A" heavy / "B" light). Chain-agnostic SC columns (e.g. combined mutation counts)
// fall back to the primary slot "A".
slotOf := func(col, isSingleCell) {
	if !isSingleCell {
		return ""
	}
	dom := col.spec.domain
	if is_undefined(dom) {
		return "A"
	}
	scChain := dom[SC_CHAIN_DOMAIN]
	if !is_undefined(scChain) {
		// A per-chain SC column MUST resolve to a known slot — refuse to silently drop a
		// column carrying an unexpected chain value (downstream only walks SLOT_ORDER).
		ll.assert(scChain == "A" || scChain == "B",
			"repertoire-score: column %s carries unexpected %s=%s (expected \"A\" or \"B\")",
			col.spec.name, SC_CHAIN_DOMAIN, scChain)
		return scChain
	}
	// --- TEMPORARY: remove once clonotype-convergence emits scClonotypeChain for SC. ---
	// The convergence block currently stamps its single-cell per-chain columns with the
	// bulk-style `pl7.app/vdj/chain` (IGHeavy/IGLight/...) instead of `scClonotypeChain`
	// (A/B). Without this, both heavy and light convergence miss the check above, collapse
	// to the "A" fallback, collide (last-write-wins), and the heavy signal is silently lost.
	// Map the bulk chain domain to the SC slot as a stopgap. When the upstream block is
	// fixed, delete this branch and BULK_CHAIN_TO_SLOT — the scClonotypeChain branch covers it.
	BULK_CHAIN_TO_SLOT := { "IGHeavy": "A", "IGLight": "B", "IGKappa": "B", "IGLambda": "B" }
	chain := dom[CHAIN_DOMAIN]
	if !is_undefined(chain) {
		// The column declares a chain we can't map to a slot — fail rather than mis-slot it
		// into the primary "A" and risk a silent collision.
		bulkSlot := BULK_CHAIN_TO_SLOT[chain]
		ll.assert(!is_undefined(bulkSlot),
			"repertoire-score: single-cell column %s carries an unmapped %s=%s — cannot assign a slot",
			col.spec.name, CHAIN_DOMAIN, chain)
		return bulkSlot
	}
	// --- end TEMPORARY ---
	// No chain domain at all -> chain-agnostic column (combined mutations).
	return "A"
}

// Route a (classified feature, is-light-chain) pair to the composite feature it contributes to,
// per the hybrid scheme. Returns undefined to DROP the column.
resolveFeature := func(fk, isLight) {
	if fk == "negLogPgen" && isLight {
		return "negLogLightPgen"
	}
	// Heavy-chain only.
	if isLight && (fk == "nbFreq" || fk == "heavyNtMutationsVJ") {
		return undefined
	}
	return fk
}

wf.prepare(func(args) {
	bb := wf.createPBundleBuilder()
	bb.ignoreMissingDomains()
	bb.addAnchor("main", args.inputAnchor)

	// All per-clonotype columns keyed on the clonotype-key axis (anchor axis idx 1) —
	// the candidate composite features.
	bb.addMulti({ axes: [{ anchor: "main", idx: 1 }] }, "features")

	// Optional subset column picked alongside the dataset (PlDatasetSelector)
	if !is_undefined(args.inputFilter) {
		bb.addRef(json.decode(args.inputFilter))
	}

	return { columns: bb.build() }
})

wf.body(func(args) {
	columns := args.columns
	datasetSpec := columns.getSpec(args.inputAnchor)
	keyAxisSpec := datasetSpec.axesSpec[1]
	isSingleCell := keyAxisSpec.name == "pl7.app/vdj/scClonotypeKey"

	// The subset a column was computed on (undefined = full data).
	subsetOf := func(col) {
		if is_undefined(col.spec.domain) {
			return undefined
		}
		if !is_undefined(col.spec.domain[SUBSET_DOMAIN]) {
			return col.spec.domain[SUBSET_DOMAIN]
		}
		return col.spec.domain[LEGACY_SUBSET_DOMAIN]
	}

	// The scores are calibrated on heavy-chain and paired heavy + light data only.
	bulkChainIsLight := false
	if !isSingleCell && !is_undefined(keyAxisSpec.domain) {
		bulkChainIsLight = !is_undefined(LIGHT_BULK_CHAINS[keyAxisSpec.domain[CHAIN_DOMAIN]])
	}
	ll.assert(!bulkChainIsLight,
		"Repertoire Score is calibrated on heavy-chain and paired heavy + light data. This dataset holds only light-chain clonotypes.")

	// --- Classify discovered columns into slots[slot][featureKey] = { col, transform, nullFill }. ---
	// J-gene mutation counts go to jCounts[slot], to be summed into that slot's V-gene count.
	slots := {}
	jCounts := {}
	for col in columns.getColumns("features") {
		cl := classify(col)
		if is_undefined(cl) {
			continue
		}
		// Skip what this block must never use.
		// Convergence only from a run on this block's own input
		sub := subsetOf(col)
		if args.featureSignal[cl.fk] == "convergence" && sub != args.inputFilter {
			continue
		}
		// Pgen from a run on the same subset, or on the full data (Pgen is
		// per sequence, so the subset's values are the same).
		if cl.fk == "negLogPgen" && !is_undefined(sub) && sub != args.inputFilter {
			continue
		}
		slot := slotOf(col, isSingleCell)
		if cl.gene == "J" {
			if !is_undefined(jCounts[slot]) {
				ll.panic("repertoire-score: two J-gene mutation-count columns in slot %s — refusing to silently pick one", slot)
			}
			jCounts[slot] = col
			continue
		}
		if is_undefined(slots[slot]) {
			slots[slot] = {}
		}
		// Each feature key maps to exactly one column per slot (features are matched by
		// unique name). A collision means an upstream block emitted duplicate or ambiguous
		// per-chain columns (e.g. heavy+light sharing a slot) — fail loudly rather than
		// silently keep the last.
		existing := slots[slot][cl.fk]
		// The one expected pair: a full-data and a subset Pgen for the same chain. The subset's wins.
		if !is_undefined(existing) && cl.fk == "negLogPgen" && !is_undefined(args.inputFilter) {
			existingSub := subsetOf(existing.col)
			// stored: full, new: subset (replace)
			if is_undefined(existingSub) && sub == args.inputFilter {
				slots[slot][cl.fk] = { col: col, transform: cl.transform, nullFill: cl.nullFill }
				continue
			}
			// stored: subset, new: full (keep stored)
			if existingSub == args.inputFilter && is_undefined(sub) {
				continue
			}
		}
		if !is_undefined(existing) {
			ll.panic("repertoire-score: two columns map to feature %s in slot %s: %s and %s — refusing to silently pick one",
				cl.fk, slot, existing.col.spec.name, col.spec.name)
		}
		slots[slot][cl.fk] = { col: col, transform: cl.transform, nullFill: cl.nullFill }
	}

	// --- Present signals -> effective tier. ---
	presentSignals := {}
	for slot in SLOT_ORDER {
		fkMap := slots[slot]
		if is_undefined(fkMap) {
			continue
		}
		for fk, _ in fkMap {
			presentSignals[args.featureSignal[fk]] = true
		}
	}
	// The signals this tier needs but the input lacks (each once, in feature order).
	// Mutations are skipped: missing mutation columns have their own stops below.
	missingSignals := func(row) {
		missing := []
		seen := {}
		for fk in args.featureOrder {
			sig := args.featureSignal[fk]
			if is_undefined(row[fk]) || sig == "mutations" || presentSignals[sig] == true || seen[sig] == true {
				continue
			}
			seen[sig] = true
			missing = append(missing, sig)
		}
		return missing
	}

	// Default: the family's last tier whose signals all arrived, so a signal the family does not
	// score has no say. Mirrors the model's tierFor.
	tier := ""
	if args.tierMode == "custom" {
		ll.assert(!is_undefined(args.tier), "custom scoring-signals mode requires a pinned tier")
		tier = args.tier
	} else {
		for t in TIER_ORDER {
			row := args.coefficients[t]
			if !is_undefined(row) && len(missingSignals(row)) == 0 {
				tier = t
			}
		}
	}
	coefMap := args.coefficients[tier]
	ll.assert(!is_undefined(coefMap), "no preset coefficients for tier %s", tier)

	// --- The resolved tier must be backed by columns that actually arrived. ---
	missing := missingSignals(coefMap)
	if len(missing) > 0 {
		sig := missing[0]
		ll.panic("scoring formula \"%s\" needs the %s signal, but no %s column reached this run. Run the %s block above this one, or switch the formula back to Default.",
			tier, sig, sig, SIGNAL_SOURCE[sig])
	}

	// --- Resolve coefficients: preset tier row, with optional per-feature custom overrides. ---
	if args.weightMode == "custom" && !is_undefined(args.customWeights) {
		merged := {}
		for k, v in coefMap {
			merged[k] = v
		}
		// Only edit the magnitude of features already in the preset tier — keep the
		// feature SET fixed by the (family, tier) preset.
		for k, v in args.customWeights {
			if !is_undefined(merged[k]) {
				merged[k] = v
			}
		}
		coefMap = merged
	}

	// --- Build the feature-column list fed to the pt recipe ---
	// Each feature gets its OWN coefficient — no light-chain scaling. Light-chain Pgen routes to
	// the explicit `negLogLightPgen` feature; light-chain convergence and V + J counts are dropped
	// (heavy-only).
	inputCols := []
	// Parallel per-column diagnostic manifest (feature, chain, source column, transform,
	// coefficient) emitted as the scoreLog output for double-checking.
	scoreLog := []
	for slot in SLOT_ORDER {
		fkMap := slots[slot]
		if is_undefined(fkMap) {
			continue
		}
		// Bulk light-chain input is refused above, so only the single-cell "B" slot is light.
		isLight := slot == "B"
		for fk in args.featureOrder {
			derived := DERIVED[fk]
			srcFk := is_undefined(derived) ? fk : derived.from
			entry := fkMap[srcFk]
			if is_undefined(entry) {
				continue
			}
			effFk := resolveFeature(fk, isLight)
			if is_undefined(effFk) {
				// e.g. light-chain convergence
				continue
			}
			coef := coefMap[effFk]
			if is_undefined(coef) {
				continue
			}
			transform := is_undefined(derived) ? entry.transform : derived.transform
			jCol := effFk == "heavyNtMutationsVJ" ? jCounts[slot] : undefined
			addend := undefined
			if !is_undefined(jCol) {
				addend = { spec: jCol.spec, data: jCol.data }
				transform = "sumVJ"
			}
			slotTag := slot == "" ? "x" : slot
			inputCols = append(inputCols, {
				header: "f_" + effFk + "_" + slotTag,
				spec: entry.col.spec,
				data: entry.col.data,
				transform: transform,
				nullFill: entry.nullFill,
				center: args.ntMutationsCenter,
				addend: addend,
				coef: coef
			})
			logEntry := {
				feature: effFk,
				chain: slotTag,
				sourceColumn: entry.col.spec.name,
				transform: transform,
				coefficient: coef
			}
			if transform == "distance" {
				logEntry.center = args.ntMutationsCenter
			}
			scoreLog = append(scoreLog, logEntry)
		}
	}

	// Every mutation feature of the preset must have its column: the score is not calibrated
	// without it. Missing CDR / total counts = not a full-length VDJRegion assembly.
	fedFeatures := {}
	for c in scoreLog {
		fedFeatures[c.feature] = true
	}
	missingVdjRegion := false
	missingHeavy := false
	for fk in args.featureOrder {
		if is_undefined(coefMap[fk]) || args.featureSignal[fk] != "mutations" || fedFeatures[fk] == true {
			continue
		}
		if fk == "heavyNtMutationsVJ" {
			missingHeavy = true
		} else {
			missingVdjRegion = true
		}
	}
	ll.assert(!missingVdjRegion,
		"Repertoire Score needs somatic-mutation columns, which MiXCR Clonotyping exports only for a full-length VDJRegion assembly. This dataset has none.")
	ll.assert(!missingHeavy,
		"The Antigen-selected preset needs MiXCR's per-gene heavy-chain mutation counts. This dataset has none.")
	ll.assert(len(inputCols) > 0,
		"no scorable feature columns present for the resolved preset (family %s, tier %s)", args.presetFamily, tier)

	// --- Output score PColumn spec. ---
	variant := TIER_VARIANT[tier]
	presetId := args.presetFamily + "-" + variant
	if args.weightMode == "custom" {
		presetId = presetId + "-custom"
	}

	scoreDomain := {}
	if isSingleCell {
		if !is_undefined(keyAxisSpec.domain) && !is_undefined(keyAxisSpec.domain[RECEPTOR_DOMAIN]) {
			scoreDomain[RECEPTOR_DOMAIN] = keyAxisSpec.domain[RECEPTOR_DOMAIN]
		}
	} else {
		if !is_undefined(keyAxisSpec.domain) && !is_undefined(keyAxisSpec.domain[CHAIN_DOMAIN]) {
			scoreDomain[CHAIN_DOMAIN] = keyAxisSpec.domain[CHAIN_DOMAIN]
		}
	}
	scoreDomain["pl7.app/vdj/repertoireScore/preset"] = presetId
	// Add subset column's id in the domain so that other blocks can trace it.
	if !is_undefined(args.inputFilter) {
		scoreDomain[SUBSET_DOMAIN] = args.inputFilter
	}

	scoreSpec := {
		kind: "PColumn",
		name: "pl7.app/vdj/repertoireScore",
		valueType: "Double",
		domain: scoreDomain,
		annotations: {
			"pl7.app/isScore": "true",
			"pl7.app/label": "Repertoire score",
			"pl7.app/description": args.presetFamily + " family, tier " + tier + " (" + variant + ")",
			"pl7.app/score/defaultCutoff": "0.8",
			"pl7.app/format": ".2f",
			"pl7.app/table/orderPriority": "95000"
		}
	}

	// Optional subset filter: only its clonotypes are scored, so the percentile ranks are
	// taken within the subset.
	filterColumn := undefined
	if !is_undefined(args.inputFilter) {
		f := columns.getColumn(json.decode(args.inputFilter))
		filterColumn = { spec: f.spec, data: f.data }
	}

	scoreResult := computeScore.computeScore(inputCols, keyAxisSpec, scoreSpec, filterColumn)
	scoreCol := scoreResult.score

	// --- Inject provenance trace and export. ---
	traceLabel := "Repertoire Score"
	if !is_undefined(datasetSpec.annotations) && !is_undefined(datasetSpec.annotations["pl7.app/label"]) {
		traceLabel = datasetSpec.annotations["pl7.app/label"]
	}
	// With a subset filter the trace roots in the filter: its own trace is dataset -> the
	// block that made the subset (e.g. Repertoire Labeling), so downstream labels name it.
	traceSourceSpec := datasetSpec
	if !is_undefined(filterColumn) {
		traceSourceSpec = filterColumn.spec
	}
	trace := pSpec.makeTrace(traceSourceSpec, {
		type: "milaboratories.repertoire-score",
		importance: 30,
		label: traceLabel
	})

	scoreSpecTraced := trace.inject(scoreCol.spec)

	// Export family: the score column only.
	frameBuilder := pframes.pFrameBuilder()
	frameBuilder.add("score", scoreSpecTraced, scoreCol.data)
	scoreFrame := frameBuilder.build()

	// Block output results table (Main page): score + exactly the metrics that fed the
	// score — nothing else. Every column is per-clonotype (the features were discovered on
	// the clonotype axis, and the score is emitted on it), so the table is naturally one row
	// per clonotype.
	// The Distributions histogram enriches this frame from the pool (model side) and picks
	// plottable signals via a spec predicate — no extra frame or per-column flag needed here.
	// Shown by default: MiXCR marks its mutation columns "optional", which would hide them here.
	shown := func(spec) {
		return maps.deepMerge(spec, { annotations: { "pl7.app/table/visibility": "default" } })
	}
	tableBuilder := pframes.pFrameBuilder()
	tableBuilder.add("score", scoreSpecTraced, scoreCol.data)
	for c in inputCols {
		// Each feature shows its raw values (honest blanks for genuine missings).
		colData := c.data
		if !is_undefined(scoreResult.subsetFeatures[c.header]) {
			colData = scoreResult.subsetFeatures[c.header].data
		}
		tableBuilder.add(c.header, shown(c.spec), colData)
		// The J-gene count summed into a V-gene count.
		if !is_undefined(c.addend) {
			addendData := c.addend.data
			if !is_undefined(scoreResult.subsetFeatures[c.header + "__add"]) {
				addendData = scoreResult.subsetFeatures[c.header + "__add"].data
			}
			tableBuilder.add(c.header + "__add", shown(c.addend.spec), addendData)
		}
	}
	tableFrame := tableBuilder.build()

	// Diagnostic manifest: the per-column weights actually applied (post light-chain
	// scaling) with each column's chain and source, for double-checking from the model.
	// canonical.encode gives sorted-key, deterministic bytes so the resource CID is stable
	// across runs — plain json.encode would vary map key order and churn the CID.
	scoreLogRes := smart.createValueResource(constants.RTYPE_JSON, canonical.encode({
		preset: presetId,
		tier: tier,
		family: args.presetFamily,
		weightMode: args.weightMode,
		columns: scoreLog
	}))

	return {
		outputs: {
			tablePf: pframes.exportFrame(tableFrame),
			scoreLog: scoreLogRes
		},
		exports: {
			score: scoreFrame
		}
	}
})
